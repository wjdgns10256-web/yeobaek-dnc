# 문의 폼 메일 발송(Resend) 설정.
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채워주세요. (.env.local은 git에 커밋되지 않습니다.)

# https://resend.com 가입 후 API Keys 메뉴에서 발급받은 키
RESEND_API_KEY=

# 문의 메일을 받을 실제 주소 (비워두면 lib/site-config.js의 email 값을 사용합니다)
CONTACT_TO_EMAIL=yeobaekcnd@naver.com

# 보내는 사람 표시 (도메인 인증 전에는 onboarding@resend.dev만 사용 가능합니다)
CONTACT_FROM_EMAIL=여백디앤씨 홈페이지 <onboarding@resend.dev>

# ---- 관리자 팝업 기능 설정 ----

# /admin 페이지 로그인 비밀번호 (직접 정해서 채워주세요)
ADMIN_PASSWORD=

# Vercel 대시보드 > Storage > Marketplace Database Providers에서 Redis(Upstash)를
# 추가하면 아래 두 값이 프로젝트에 자동으로 연결됩니다. (로컬 .env.local에는
# Vercel 대시보드의 값을 그대로 복사해오면 됩니다. 비워두면 로컬 개발용 메모리
# 저장소로 동작하며, 서버가 재시작되면 팝업 데이터가 초기화됩니다.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
